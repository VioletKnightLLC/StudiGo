{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GoPro Webcam Studio",
  "version": "0.1.0",
  "identifier": "com.gopro.webcam-studio",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 5173",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "GoPro Webcam Studio",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}